// Prisma schema for the personal dashboard.
//
// Conventions (see AGENTS.md):
// - Financial amounts use an exact decimal type (Decimal(18, 2)), never floating point.
//   A negative amount is an outflow, a positive amount is an inflow.
// - Operation dates are stored as DATE (no time, no time zone).
// - Instants (creation, update, synchronisation) are stored as timestamptz, in UTC.
// - Currency is a 3-letter ISO 4217 code, EUR by default.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

/// A property is not necessarily rented: `occupancy` is explicit.
enum PropertyOccupancy {
  RENTED
  VACANT
  OWNER_OCCUPIED
  SEASONAL
  OTHER
}

enum CashflowKind {
  INCOME
  EXPENSE
}

/// Recurring obligations of a property that are not financial transactions yet.
enum PropertyEventKind {
  TAX
  INSURANCE
  MAINTENANCE
  LEASE
  INSPECTION
  LOAN
  RENOVATION
  OTHER
}

enum PropertyEventStatus {
  PLANNED
  DONE
  CANCELLED
}

enum IntegrationProvider {
  GITHUB
  GITLAB
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

/// The lifecycle of one synchronisation attempt. `PARTIAL` means the run completed
/// but some repositories were left unread (the run bound, or a provider refusal):
/// their data is unknown, not empty.
enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// The two levels of the salary calendar: a day is planned (the simulated budget),
/// then really worked (the amount actually earned). One state at a time.
enum WorkDayStatus {
  PLANNED
  WORKED
}

/// How often a recurring definition occurs. Quarterly and yearly cover the series
/// that are not monthly (taxes, insurance, quarterly rents); a cadence that is not
/// a whole number of months is deliberately not offered.
enum RecurrenceFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// The lifecycle of one materialised occurrence. A decision is terminal — no state
/// returns to `PENDING` — so the audit trail never loses a step: a skipped or
/// dismissed échéance stays visible, and a confirmed one keeps its transaction.
enum RecurringOccurrenceStatus {
  PENDING
  CONFIRMED
  SKIPPED
  DISMISSED
}

/// The lifecycle of a goal. `ACHIEVED` and `ABANDONED` are explicit choices, never
/// derived: progress is a computed figure, the status is what the owner decided.
enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

/// The well-understood situations the alert engine watches. Deterministic rules only:
/// no statistical heuristics in the first pass.
enum AlertKind {
  LOW_BALANCE
  BUDGET_OVERRUN
  BUDGET_THRESHOLD
  UNUSUAL_EXPENSE
  STALE_INTEGRATION
  OVERDUE_EVENT
}

/// The lifecycle of one alert. `DISMISSED` is the owner's choice and sticks while the
/// condition holds; `RESOLVED` means the condition stopped being true — a resolved
/// alert that triggers again reopens, a dismissed one waits for that resolution first.
enum AlertStatus {
  ACTIVE
  DISMISSED
  RESOLVED
}

/// An open issue and an open pull request arrive from the same provider endpoint;
/// they stay distinct because they call for different actions.
enum IssueKind {
  ISSUE
  PULL_REQUEST
}

/// Coarse client family of a persisted session. Never a user agent, an address or a
/// fingerprint: it is only there to tell two sessions apart in the account page.
enum SessionClient {
  WEB
  MOBILE
  UNKNOWN
}

/// What a workspace holds. Personal and company data never share one by default.
enum WorkspaceKind {
  PERSONAL
  FAMILY
  COMPANY
}

/// Highest first. Only OWNER exists until invitations land (M8-01).
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// A space (personal, family, company) whose members share its data.
/// Every budget, real-estate, integration and alert record belongs to one (M7-04).
model Workspace {
  id        String        @id @default(cuid())
  name      String
  kind      WorkspaceKind @default(PERSONAL)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  members WorkspaceMember[]
  modules WorkspaceModule[]

  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  budgets              Budget[]
  salarySetting        SalarySetting?
  salaryRates          SalaryRate[]
  workDays             WorkDay[]
  recurringEntries     RecurringEntry[]
  recurringOccurrences RecurringOccurrence[]
  goals                Goal[]
  goalContributions    GoalContribution[]
  properties           Property[]
  connections          IntegrationConnection[]
  alerts               Alert[]
  alertRules           AlertRule[]
  auditEvents          AuditEvent[]
}

/// Activation of one catalog module (`src/modules/catalog`) in one workspace. The key is
/// text, validated against the catalog in code: a new module needs no migration.
/// Disabling only flips `enabled`: the module's records and its configuration stay.
model WorkspaceModule {
  workspaceId String
  moduleKey   String
  enabled     Boolean  @default(true)
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, moduleKey])
}

/// One user's access to one workspace. Without a row here, a user reaches nothing.
model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Sole owner of the dashboard. No public sign-up: users are created by the seed script.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  accounts    Account[]
  categories  Category[]
  transactions Transaction[]
  budgets     Budget[]
  salarySetting SalarySetting?
  salaryRates SalaryRate[]
  workDays    WorkDay[]
  recurringEntries RecurringEntry[]
  recurringOccurrences RecurringOccurrence[]
  goals       Goal[]
  goalContributions GoalContribution[]
  properties  Property[]
  connections IntegrationConnection[]
  alerts      Alert[]
  alertRules  AlertRule[]
  auditEvents AuditEvent[]
  memberships WorkspaceMember[]
  sessions    Session[]
}

/// One signed-in browser session, persisted so the owner can revoke it.
///
/// The row never holds the JWT, a token, a full user agent, an address or a
/// fingerprint: only a coarse client label and the two instants the account page
/// displays. The token carries this row's `id`; a revoked or missing row makes the
/// token unusable immediately, without waiting for it to expire.
model Session {
  id         String        @id @default(cuid())
  userId     String
  client     SessionClient @default(UNKNOWN)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  /// Last successfully validated request, refreshed at most every few minutes.
  lastSeenAt DateTime      @default(now()) @db.Timestamptz(3)
  /// Null while active. Set by a revocation or by a password change; never cleared.
  revokedAt  DateTime?     @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// A manually tracked account. No banking credentials are ever stored here.
model Account {
  id        String      @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId    String?
  workspaceId String
  name      String
  type      AccountType @default(CHECKING)
  currency  String      @default("EUR") @db.Char(3)
  /// Optional owner-defined low-balance floor, in the account currency. Null means
  /// "no explicit floor": the simulation suggests one from the account's expenses,
  /// while the alert engine falls back to the global LOW_BALANCE rule.
  lowBalanceThreshold Decimal? @db.Decimal(18, 2)
  archivedAt DateTime?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringEntries RecurringEntry[]
  goals        Goal[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Category {
  id        String       @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId    String?
  workspaceId String
  name      String
  kind      CategoryKind
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurringEntries RecurringEntry[]

  @@unique([workspaceId, name, kind])
  @@index([workspaceId])
}

model Transaction {
  id       String          @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId   String?
  workspaceId String
  accountId String
  categoryId String?
  type     TransactionType
  label    String
  /// Signed amount in the account currency: negative for an outflow.
  amount   Decimal         @db.Decimal(18, 2)
  currency String          @default("EUR") @db.Char(3)
  /// Operation date, distinct from createdAt and from any synchronisation date.
  operationDate DateTime  @db.Date
  notes    String?
  /// Stable identifier of the source record, used to make imports re-runnable.
  externalRef String?
  /// Shared by the two movements of an internal transfer created in one action;
  /// `null` for every single-leg entry, including a transfer typed by hand. Both
  /// legs keep their own account's currency: a linked transfer only exists within
  /// one currency, the app never converts.
  transferGroupId String?
  /// Day the line was checked against a bank statement. `null` means "not checked
  /// yet" — a normal state, never an error — and ticking never changes the amount,
  /// the date or the account.
  reconciledAt DateTime?   @db.Date
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cashflows PropertyCashflow[]
  recurringOccurrence RecurringOccurrence?

  @@unique([accountId, externalRef])
  @@index([workspaceId, operationDate])
  @@index([workspaceId, categoryId])
}

/// A planned amount for one category, one month and one currency.
///
/// The amount is a positive magnitude: the category's kind says whether this is a
/// spending envelope or an income target. Currencies are never converted, so the same
/// category may carry one budget per currency — and exactly one, which the unique
/// constraint enforces.
model Budget {
  id         String   @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId     String?
  workspaceId String
  categoryId String
  year       Int
  /// 1-based month, as a human writes it.
  month      Int
  currency   String   @default("EUR") @db.Char(3)
  amount     Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, categoryId, year, month, currency])
  @@index([workspaceId, year, month])
}

/// The simulator's options, common to every month: the default length of a plannable
/// day and the currency. The hourly rate itself is month-scoped (see `SalaryRate`).
model SalarySetting {
  id         String   @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId     String?  @unique
  workspaceId String @unique
  /// Default length of a plannable day, in hours. Applies to future clicks only.
  hoursPerDay Decimal @db.Decimal(4, 2)
  currency   String   @default("EUR") @db.Char(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// One hourly-rate change point: the rate applies **from this month on**, until the next
/// entry. Resolving a month means reading the most recent entry at or before it, like an
/// effective-dated wage; a month before the first entry has no rate at all (its
/// simulation is unavailable rather than computed from an invented default).
model SalaryRate {
  id         String   @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId     String?
  workspaceId String
  year       Int
  month      Int
  /// Exact hourly rate, in the simulator's currency.
  hourlyRate Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, year, month])
}

/// One clicked day of the salary calendar. The status is the level the owner reached:
/// `PLANNED` feeds the simulated budget, `WORKED` the real amount. One row per owner
/// and day, which the unique constraint enforces; the third click removes the row.
model WorkDay {
  id     String        @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId String?
  workspaceId String
  date   DateTime      @db.Date
  status WorkDayStatus @default(PLANNED)
  /// Hours for this day, adjustable by half-hours.
  hours  Decimal       @db.Decimal(4, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
}

/// A recurring definition of an expected income or expense (rent, subscription, salary).
///
/// The definition never writes to the ledger by itself: it only describes a series, and
/// each occurrence must be confirmed explicitly — the confirmation goes through the same
/// creation path as a manually typed transaction. `amount` is a positive magnitude;
/// `type` carries the direction, the way a budget's category kind carries it.
model RecurringEntry {
  id         String              @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId     String?
  workspaceId String
  accountId  String
  categoryId String?
  type       TransactionType
  label      String
  /// Planned magnitude, always positive; the sign comes from `type` at confirmation.
  amount     Decimal             @db.Decimal(18, 2)
  frequency  RecurrenceFrequency @default(MONTHLY)
  /// First day of the series; its day-of-month is the recurring day (31 → end of
  /// shorter months, see `occurrenceDatesForMonth`).
  startDate  DateTime            @db.Date
  /// Last day of the series, inclusive. Null means the series has no end.
  endDate    DateTime?           @db.Date
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)

  user        User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  occurrences RecurringOccurrence[]

  @@index([workspaceId])
}

/// One occurrence of a recurring definition, materialised for a month.
///
/// Created in bulk and idempotently when a month is opened; the unique
/// (recurringId, date) keeps a second opening from duplicating it. `transactionId` is
/// set by the confirmation and unique, so a replay cannot book the same occurrence
/// twice. Deleting that transaction deletes its occurrence row instead of leaving a
/// phantom "confirmed": opening the month again offers the échéance anew, which is
/// the honest reading of a booking that no longer exists.
model RecurringOccurrence {
  id            String                    @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId        String?
  workspaceId String
  recurringId   String
  /// Calendar day of the occurrence, a `DATE` like every operation date.
  date          DateTime                  @db.Date
  status        RecurringOccurrenceStatus @default(PENDING)
  transactionId String?                   @unique
  /// When the confirm, skip or dismiss decision was taken. Null while pending.
  decidedAt     DateTime?                 @db.Timestamptz(3)
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(3)

  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recurring   RecurringEntry @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  transaction Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([recurringId, date])
  @@index([workspaceId, status, date])
}

/// A savings or repayment goal: a target amount in one currency, to be set aside (or
/// repaid) by a target date.
///
/// The current amount comes from one of two sources — the recorded balance of a linked
/// account, or a manual amount (`currentAmount` and `accountId` are mutually exclusive,
/// enforced by the input contract). Logged contributions (see `GoalContribution`) add
/// to the manual amount: starting amount + everything set aside since. With neither a
/// manual amount nor a contribution, progress is *unknown* and is read as unknown,
/// never as zero. A linked account must carry the goal's currency and takes no
/// contributions: no conversion ever happens.
model Goal {
  id           String     @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId       String?
  workspaceId String
  name         String
  targetAmount Decimal    @db.Decimal(18, 2)
  currency     String     @default("EUR") @db.Char(3)
  targetDate   DateTime   @db.Date
  status       GoalStatus @default(ACTIVE)
  /// Manual current amount, never negative; mutually exclusive with `accountId`.
  currentAmount Decimal?  @db.Decimal(18, 2)
  accountId    String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account       Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([workspaceId])
}

/// One amount set aside (or repaid) for a goal on a given day.
///
/// A contribution is a **log entry**, not a ledger transaction: it never touches an
/// account balance and carries its own date, so progress over time stays readable.
/// Only manual goals accept contributions — a goal linked to an account reads that
/// account's balance and takes no contributions. `amount` is a positive magnitude in
/// the goal's currency, like a budget amount.
model GoalContribution {
  id     String   @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId String?
  workspaceId String
  goalId String
  /// Positive magnitude, in the goal's currency.
  amount Decimal  @db.Decimal(18, 2)
  /// Day the amount was set aside, a `DATE` like every operation date.
  date   DateTime @db.Date
  note   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([workspaceId, goalId, date])
}

/// A property tracked by its owner.
///
/// The acquisition, valuation and sale amounts below share one explicit reference
/// currency (`currency`). Cashflow entries keep their own currency and are never
/// converted: a figure is only ever compared with another figure of the same currency.
/// A missing price reads "unknown", never zero.
model Property {
  id        String            @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId    String?
  workspaceId String
  name      String
  address   String?
  occupancy PropertyOccupancy @default(VACANT)
  /// Reference currency of the prices below.
  currency  String            @default("EUR") @db.Char(3)
  purchaseDate  DateTime?     @db.Date
  /// Acquisition price, positive; null = not recorded.
  purchasePrice Decimal?      @db.Decimal(18, 2)
  /// Latest estimated market value, dated by `estimatedValueAsOf`; null = not recorded.
  estimatedValue Decimal?     @db.Decimal(18, 2)
  estimatedValueAsOf DateTime? @db.Date
  /// Margin in percent required above the break-even sale price (10 by default).
  targetGainRate Decimal      @default(10) @db.Decimal(5, 2)
  /// Sale date, set together with `salePrice`; null = the property is not sold.
  saleDate  DateTime?         @db.Date
  /// Sale price, positive; null while the property is not sold (or not recorded).
  salePrice Decimal?          @db.Decimal(18, 2)
  /// Selling costs (agency, diagnostics...), positive; null = not recorded.
  saleCosts Decimal?          @db.Decimal(18, 2)
  notes     String?
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cashflows PropertyCashflow[]
  loans     PropertyLoan[]
  valuations PropertyValuation[]
  events    PropertyEvent[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Append-only valuation snapshot. A missing row means unknown, never zero.
model PropertyValuation {
  id         String   @id @default(cuid())
  propertyId String
  valuedOn   DateTime @db.Date
  amount     Decimal  @db.Decimal(18, 2)
  currency   String   @db.Char(3)
  sourceNote String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, valuedOn])
}

/// A loan financing a property.
///
/// Financing is deliberately kept apart from operating cashflow: **none of these
/// amounts feed `computePropertyTotals`**. Interest, principal and insurance are the
/// cost of owning the asset, not the asset's operating result, so adding them to the
/// cashflow totals would double-count the money that also appears in the budget.
///
/// `outstandingBalance` is a **stored snapshot** with its observation date
/// (`balanceAsOf`); it is never derived here. A loan whose balance was never recorded
/// reads "inconnu", never zero. Every monetary field and the rate are exact decimals,
/// and the currency is explicit: nothing is ever converted between currencies.
model PropertyLoan {
  id                 String    @id @default(cuid())
  propertyId         String
  label              String
  currency           String    @default("EUR") @db.Char(3)
  /// Positive magnitude: the amount borrowed.
  initialPrincipal   Decimal   @db.Decimal(18, 2)
  /// Stored balance snapshot; null means "not recorded yet".
  outstandingBalance Decimal?  @db.Decimal(18, 2)
  /// Date the outstanding balance was observed; set together with it.
  balanceAsOf        DateTime? @db.Date
  /// Annual rate as a percentage (for example 3.45), positive; null = not recorded.
  interestRate       Decimal?  @db.Decimal(18, 2)
  /// Term in whole months; null = not recorded.
  termMonths         Int?
  /// Monthly payment, positive; null = not recorded.
  paymentAmount      Decimal?  @db.Decimal(18, 2)
  /// Monthly insurance, positive; null = not recorded.
  insuranceAmount    Decimal?  @db.Decimal(18, 2)
  startDate          DateTime? @db.Date
  endDate            DateTime? @db.Date
  notes              String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

/// A financial entry attached to a property.
///
/// Double-counting rule: `transactionId` and `amount` are mutually exclusive.
/// When the entry is linked to a transaction, the amount comes from the transaction
/// and `amount` stays null; property totals resolve the linked transaction instead
/// of adding a second amount.
model PropertyCashflow {
  id            String        @id @default(cuid())
  propertyId    String
  /// A transaction can be attached to at most one property.
  transactionId String?       @unique
  kind          CashflowKind
  /// Signed amount, only set for standalone entries (no linked transaction).
  amount        Decimal?      @db.Decimal(18, 2)
  currency      String        @default("EUR") @db.Char(3)
  label         String
  /// Expected date for a charge or a rent; distinct from the settlement date.
  dueDate       DateTime?     @db.Date
  settledAt     DateTime?     @db.Date
  notes         String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([propertyId, dueDate])
}

/// A dated obligation of a property: a tax, an insurance premium, a lease renewal,
/// an inspection, a loan deadline or renovation work.
///
/// An event is a reminder, not a financial entry: its optional `amount` is
/// **informational only** and never enters the property totals or the budget. Only a
/// transaction (or a cashflow entry) moves money, so creating an event can never create
/// a duplicate payment.
///
/// `dueDate` is a calendar day. An event without a date is never overdue: it stays
/// explicitly undated rather than borrowing a date it does not have.
model PropertyEvent {
  id         String              @id @default(cuid())
  propertyId String
  kind       PropertyEventKind
  label      String
  /// Calendar day the obligation is due; null = no date recorded yet.
  dueDate    DateTime?           @db.Date
  status     PropertyEventStatus @default(PLANNED)
  /// Indicative amount, positive; null = not recorded. Never part of a financial total.
  amount     Decimal?            @db.Decimal(18, 2)
  /// Currency of `amount`; null when no amount is recorded.
  currency   String?             @db.Char(3)
  notes      String?
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, dueDate])
  @@index([propertyId, status])
}

/// Read-only connection to a GitHub or GitLab instance.
/// Secrets are never returned to the browser; `credentialsCiphertext` holds the
/// encrypted token (AES-256-GCM, key from INTEGRATION_ENCRYPTION_KEY).
model IntegrationConnection {
  id       String              @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId   String?
  workspaceId String
  provider IntegrationProvider
  /// GitLab may be self-hosted. Empty string means the provider's public instance,
  /// which keeps the uniqueness constraint reliable (NULL is not comparable in PostgreSQL).
  instanceUrl String           @default("")
  /// Owner, group or organisation whose projects are tracked.
  externalOwner String?
  /// Permissions actually granted by the provider.
  permissions   String[]
  status        IntegrationStatus @default(NOT_CONNECTED)
  lastSyncedAt  DateTime?         @db.Timestamptz(3)
  lastSyncError String?
  credentialsCiphertext String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshots ProjectSnapshot[]
  issues    IssueSnapshot[]
  milestones MilestoneSnapshot[]
  cacheEntries ProviderCacheEntry[]
  ciRuns    CiRunSnapshot[]
  syncRuns  SyncRun[]

  @@unique([workspaceId, provider, instanceUrl])
  @@index([workspaceId])
}

/// Normalised project data kept only to render the dashboard, with its source
/// and its fetch date. No private source code content is stored.
model ProjectSnapshot {
  id           String              @id @default(cuid())
  connectionId String
  provider     IntegrationProvider
  externalId   String
  externalUrl  String
  name         String
  visibility   String?
  metrics      Json?
  /// Instant of the last successful fetch for this project.
  fetchedAt    DateTime            @db.Timestamptz(3)
  /// Last time the CI runs of this repository were requested (DA-03). `null` means
  /// never requested: outside the bounded selection, or a provider without CI support.
  ciCheckedAt  DateTime?           @db.Timestamptz(3)
  /// Safe error code of that request (e.g. "UNAUTHORIZED (HTTP 403)"), `null` when
  /// the runs were read. A refused read is "unavailable", never "no runs".
  ciError      String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, fetchedAt])
}

/// An open issue or pull request, kept only to render the dashboard.
///
/// Deliberately narrow: title, identifier, address, author, comment count, labels
/// and dates. No description, no comment text, no source code: those belong to the
/// provider and often carry things that must not be copied into another tool.
/// Closed issues are not kept: a row disappears at the next synchronisation, which
/// is what makes the list a to-do list rather than an archive.
model IssueSnapshot {
  id           String              @id @default(cuid())
  connectionId String
  provider     IntegrationProvider
  /// Provider identifier, kept so a re-run updates instead of duplicating.
  externalId   String
  kind         IssueKind
  /// Repository full name, for example "owner/repo".
  repository   String
  number       Int
  title        String
  url          String
  authorLogin  String?
  /// Logins of the assignees. Empty means nobody picked it up yet, which is a state
  /// worth seeing, not a missing value.
  assignees    String[]
  /// Milestone title, as displayed by the provider. `null` means "no milestone":
  /// GitHub has no milestone notion beyond a title here, so no foreign key is kept.
  milestone    String?
  commentsCount Int
  labels       String[]
  /// Instant the issue was opened at the provider.
  openedAt     DateTime            @db.Timestamptz(3)
  /// Instant of the last activity at the provider (comment, label, edit).
  activityAt   DateTime            @db.Timestamptz(3)
  fetchedAt    DateTime            @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, fetchedAt])
  @@index([connectionId, kind, openedAt])
  @@index([connectionId, milestone])
}

/// A milestone, kept to show progress and due dates.
///
/// The counters come from the provider and cover everything attached to the
/// milestone, not only the issues kept here: they are the authoritative figures, and
/// the interface labels them as such instead of recomputing a smaller number.
model MilestoneSnapshot {
  id           String              @id @default(cuid())
  connectionId String
  provider     IntegrationProvider
  externalId   String
  /// Repository full name, for example "owner/repo".
  repository   String
  number       Int
  title        String
  /// "open" or "closed", as the provider reports it.
  state        String
  /// Provider due date. GitHub stores a time on it, which is meaningless: only the day
  /// is displayed, in UTC, like every other date of this project.
  dueOn        DateTime?           @db.Timestamptz(3)
  issuesOpen   Int
  issuesClosed Int
  url          String
  fetchedAt    DateTime            @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, state, dueOn])
}

/// Cache validators of one per-repository provider request (DA-04).
///
/// Not a payload cache: only the validators the provider returned (`ETag`,
/// `Last-Modified`) and two instants. The rows themselves stay in the snapshot
/// tables. Validators are not secrets; they are dropped with the connection, on a
/// token change, and are ignored once older than the cache maximum age.
model ProviderCacheEntry {
  id           String   @id @default(cuid())
  connectionId String
  /// "issues" or "milestones": what the cached request lists.
  kind         String
  /// Repository full name, for example "owner/repo".
  repository   String
  /// Cache version and exact request URL (see `cacheResourceKey`).
  resource     String
  etag         String?
  lastModified String?
  /// Last successful check, full answer or 304.
  checkedAt    DateTime @db.Timestamptz(3)
  /// Last time the rows were written from a full answer.
  changedAt    DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, resource])
  @@index([connectionId, repository])
}

/// A recent GitHub Actions workflow run of a tracked repository (DA-03).
///
/// Current state, not history: each synchronisation keeps only the runs the bounded
/// fetch returned for a repository it read, and drops the others. Only the fields
/// displayed are stored — no logs, no job output, no commit content.
model CiRunSnapshot {
  id           String              @id @default(cuid())
  connectionId String
  provider     IntegrationProvider
  /// Provider run identifier, kept so a re-run updates instead of duplicating.
  externalId   String
  /// Repository full name, for example "owner/repo".
  repository   String
  workflowName String
  branch       String?
  /// "queued", "in_progress", "completed"..., as the provider reports it.
  status       String
  /// "success", "failure", "cancelled"...; `null` while the run is not completed.
  conclusion   String?
  url          String
  /// Instant the run started at the provider.
  startedAt    DateTime            @db.Timestamptz(3)
  /// Instant of the provider's last update; the end of a completed run.
  runUpdatedAt DateTime            @db.Timestamptz(3)
  fetchedAt    DateTime            @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, repository])
}

/// One synchronisation attempt, kept so freshness and failures stay observable.
///
/// A run is opened before the first provider request and closed in every outcome —
/// success, partial completion or failure — so it can never end up as a `RUNNING`
/// row without a process. Counters describe what the run actually did:
/// - `fetched` counts provider items read (projects, issues and pull requests,
///   milestones);
/// - `created` and `updated` count snapshot rows first seen versus refreshed;
/// - `skipped` and `failed` count repositories, the unit the run bound and provider
///   refusals operate on. Both mean "not read": their data is unknown, never zero.
///
/// Only a safe summary is stored, never a token, a response body or a provider URL
/// carrying credentials. Retention is documented in `docs/architecture/overview.md`
/// and applied by `npm run db:cleanup`.
model SyncRun {
  id           String        @id @default(cuid())
  connectionId String
  status       SyncRunStatus @default(RUNNING)
  startedAt    DateTime      @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime?     @db.Timestamptz(3)
  fetched      Int           @default(0)
  created      Int           @default(0)
  updated      Int           @default(0)
  skipped      Int           @default(0)
  failed       Int           @default(0)
  /// Bounded retries used by this run (transient failures only).
  retries      Int           @default(0)
  /// Safe error code for a failed run, for example "RATE_LIMITED (HTTP 403)".
  errorSummary String?

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
}

/// One evaluated warning about the owner's data (see `src/modules/alerts`).
///
/// The row never stores free text: `inputs` holds the message inputs as plain strings
/// (amounts, names, dates, computed gaps) and the French reason is recomputed from them
/// at render time, so a forged request can never write the sentence a page displays.
/// The `fingerprint` (rule + entity + period) is unique per owner: re-evaluating the
/// same condition refreshes the row instead of duplicating it, and the unicity also
/// absorbs a concurrent double evaluation.
///
/// Alerts are observations only — no rule ever writes to the ledger.
model Alert {
  id          String      @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId      String?
  workspaceId String
  kind        AlertKind
  /// Stable identity of the watched condition: rule + entity + period.
  fingerprint String
  status      AlertStatus @default(ACTIVE)
  /// Message inputs, strings only, recomputed into the displayed reason.
  inputs      Json
  /// When the current open episode started (reset on every re-trigger).
  triggeredAt DateTime    @default(now()) @db.Timestamptz(3)
  /// Last evaluation that still saw the condition.
  lastSeenAt  DateTime    @db.Timestamptz(3)
  dismissedAt DateTime?   @db.Timestamptz(3)
  resolvedAt  DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, status])
}

/// One rule's configuration, per owner and kind.
///
/// A missing row means "defaults" (`ALERT_RULE_DEFAULTS` in `src/modules/alerts`),
/// so the engine works before any settings are saved. Only the thresholds that make
/// sense for a kind are set: an amount for `LOW_BALANCE` and `UNUSUAL_EXPENSE` (with
/// its currency — amounts in another currency are never compared, they are skipped),
/// a percentage for `BUDGET_OVERRUN`, a number of days for `STALE_INTEGRATION` and
/// `OVERDUE_EVENT`.
model AlertRule {
  id                String    @id @default(cuid())
  /// Legacy author column, kept nullable for rollback (M7-04); scoping uses `workspaceId`.
  userId            String?
  workspaceId String
  kind              AlertKind
  enabled           Boolean   @default(true)
  thresholdAmount   Decimal?  @db.Decimal(18, 2)
  thresholdCurrency String?   @db.Char(3)
  thresholdPercent  Decimal?  @db.Decimal(6, 2)
  thresholdDays     Int?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind])
}

/// One security-relevant or data-changing action, kept for the owner's own review.
///
/// Append-only from the application's perspective: no Route Handler, Server Action or
/// job updates or deletes a row, and nothing exposes a write to the browser. Only
/// codes, identifiers and counts are stored — never a payload, a label, an amount or a
/// secret: `redactAuditMetadata` in `src/modules/audit` drops them before insert.
///
/// `actorId` is null when the action has no signed-in user (a job or a scheduler), so
/// the entry survives the actor's deletion instead of disappearing with them.
///
/// The action codes live in code (`AUDIT_ACTIONS`), like module keys: adding one needs
/// no migration. Retention is documented in `docs/architecture/overview.md`.
model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  /// Stable action code, for example `export.transactions`.
  action      String
  /// Coarse entity family, for example `EXPORT` or `TRANSACTION`.
  entityType  String
  /// Identifier of the entity, when a single row is concerned.
  entityId    String?
  /// `SUCCESS`, `REFUSED` or `FAILED`.
  outcome     String
  /// Safe metadata: counts, codes and calendar days only.
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action, createdAt])
}
